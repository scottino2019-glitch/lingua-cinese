@import url("https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap");

body { font-family: Nunito, sans-serif; background-color: rgb(243, 244, 246); margin: 0px; padding: 20px; }

.glass-card { background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); border-radius: 16px; border: 1px solid rgba(255, 255, 255, 0.2); box-shadow: rgba(0, 0, 0, 0.1) 0px 4px 30px; }

.manga-style { border: 3px solid rgb(31, 41, 55); border-radius: 16px; box-shadow: rgb(31, 41, 55) 6px 6px 0px; transition: transform 0.2s, box-shadow 0.2s; }

.manga-button { border: 2px solid rgb(31, 41, 55); box-shadow: rgb(31, 41, 55) 3px 3px 0px; transition: 0.2s; }

.manga-button:active { transform: translate(3px, 3px); box-shadow: rgb(31, 41, 55) 0px 0px 0px; }

.feedback-animation { animation: 0.3s ease-out 0s 1 normal none running popIn; }

@keyframes popIn { 
  0% { transform: scale(0.8); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}
